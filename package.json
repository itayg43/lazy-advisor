{
  "name": "lazy-advisor",
  "version": "1.0.0",
  "description": "Agentic investment planning CLI for beginner ETF investors",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:evals": "dotenvx run -f .env.test -- vitest run --config vitest.config.evals.ts",
    "dev:server": "dotenvx run -- tsx watch src/server/server.ts",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itayg43/lazy-advisor.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#config": "./src/server/config.ts",
    "#constants/*": "./src/server/constants/*",
    "#errors": "./src/server/errors/index.ts",
    "#clients/*": "./src/server/clients/*",
    "#lib/*": "./src/server/lib/*",
    "#pipeline/*": "./src/server/pipeline/*",
    "#repositories/*": "./src/server/repositories/*",
    "#schemas/*": "./src/server/schemas/*",
    "#services/*": "./src/server/services/*",
    "#types/*": "./src/server/types/*"
  },
  "bugs": {
    "url": "https://github.com/itayg43/lazy-advisor/issues"
  },
  "homepage": "https://github.com/itayg43/lazy-advisor#readme",
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.59.1",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "secretlint": "^11.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*": "secretlint",
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "envalid": "^8.1.1",
    "http-status-codes": "^2.3.0",
    "openai": "^6.32.0",
    "zod": "^3.25.76"
  }
}
